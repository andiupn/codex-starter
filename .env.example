# ============================================================
# PLACEHOLDER — GANTI SEBELUM DIPAKAI
# ============================================================
# Copy file ini ke .env dan ganti semua nilai placeholder
# dengan credentials / konfigurasi asli.
#
# .env sudah di .gitignore — aman untuk menyimpan rahasia.
# Hanya .env.example yang boleh di-track git.
#
# Contoh:
#   DATABASE_URL=mysql://user:pass@localhost:3306/dbname
#   API_KEY=sk-real-key-here
#   SESSION_SECRET=generate-random-string
